# Smart Healthcare Platform — Backend Environment Configuration Example
# Copy this file to .env or set these environment variables in your shell.

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_healthcare_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JPA / Hibernate Settings
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=false
