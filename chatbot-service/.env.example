# ==============================================================================
# SmartHealth Chatbot Service — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Selection
# Options:
#   - 'mock'               : Deterministic mock mode (default, for testing/offline dev)
#   - 'ollama'             : Local Ollama instance (OpenAI-compatible /v1 endpoint)
#   - 'openai_compatible'  : Remote or local OpenAI-compatible endpoint (OpenAI, vLLM, Azure, etc.)
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock

# ------------------------------------------------------------------------------
# 2. Ollama Configuration Example (Local Development)
# Run locally with: ollama run llama3
# ------------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3
# LLM_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 3. OpenAI-Compatible Provider Example (Commercial or Hosted)
# Never commit real API keys to source control!
# ------------------------------------------------------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-api-key-here
# LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. Service Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO
